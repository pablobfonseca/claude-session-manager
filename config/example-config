# Claude Code Session Manager - Example Configuration
# Copy to ~/.config/claude-session-manager/config and customize

# Popup dimensions
POPUP_WIDTH="60%"
POPUP_HEIGHT="60%"

# Session Detection Patterns
# Add patterns that match your Claude Code session naming
CLAUDE_PATTERNS=(
    "claude"
    "anthropic"
    "ai-session"
    "claude-code"
    "cc-"
    "ai-"
)

# Cyberpunk Color Theme
COLOR_ACTIVE="#00ff41"        # Matrix green - actively working
COLOR_WAITING="#ffff00"       # Cyber yellow - needs input
COLOR_COMPLETE="#00ffff"      # Electric cyan - task complete
COLOR_ERROR="#ff007f"         # Neon pink - has errors
COLOR_STARTING="#bf00ff"      # Electric purple - initializing
COLOR_INACTIVE="#8b93a6"      # Muted gray - inactive

# Alternative Color Themes

# Classic Terminal Theme

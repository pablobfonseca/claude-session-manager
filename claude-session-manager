#!/usr/bin/env bash

# Claude Code Session Manager
# Main entry point for managing Claude Code AI sessions in tmux
# Author: Pablo Fonseca <pablobfonseca777@gmail.com>

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
VERSION="1.1.0"

# Source the integration scripts
TMUX_SCRIPT="$SCRIPT_DIR/src/tmux_integration.sh"
DETECTOR_SCRIPT="$SCRIPT_DIR/src/claude_session_detector.sh"

# Configuration
CONFIG_DIR="${HOME}/.config/claude-session-manager"
CONFIG_FILE="$CONFIG_DIR/config"

# Ensure scripts are executable
chmod +x "$TMUX_SCRIPT" "$DETECTOR_SCRIPT" 2>/dev/null || true

# Show version information
show_version() {
    echo "Claude Code Session Manager v$VERSION"
    echo "Repository: https://github.com/pablobfonseca/claude-session-manager"
}

# Show help information
show_help() {
    echo "Claude Code Session Manager - Monitor and manage Claude Code AI sessions"
    echo ""
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "🖥️  Display Commands:"
    echo "  show              Show session status popup"
    echo "  picker            Open fzf session picker with preview"
    echo ""
    echo "🔍 Session Commands:"
    echo "  list              List all Claude Code sessions with status"
    echo "  status <session>  Get status of specific session"
    echo "  switch <session>  Switch to specific Claude Code session"
    echo "  widget            Compact tmux status bar segment"
    echo ""
    echo "🚀 Quick Navigation:"
    echo "  jump approval     Jump to sessions needing approval"
    echo "  jump active       Jump to active sessions"
    echo "  jump idle         Jump to idle sessions"
    echo ""
    echo "⚙️  Setup Commands:"
    echo "  install           Install and configure Claude Session Manager"
    echo "  uninstall         Remove configuration"
    echo "  configure         Open configuration file"
    echo ""
    echo "ℹ️  Info Commands:"
    echo "  version           Show version information"
    echo "  help              Show this help message"
    echo ""
    echo "Example tmux.conf bindings:"
    echo "  bind-key g run-shell 'claude-session-manager show'"
    echo "  bind-key G run-shell 'claude-session-manager picker'"
    echo ""
    echo "Examples:"
    echo "  $0 show                    # Show session status popup"
    echo "  $0 picker                  # Open fzf session picker"
    echo "  $0 jump approval           # Jump to sessions needing approval"
    echo "  $0 list                    # List all Claude Code sessions"
}

# Install Claude Session Manager
install_manager() {
    echo "🤖 Installing Claude Code Session Manager..."

    # Create config directory
    mkdir -p "$CONFIG_DIR"

    # Create default configuration
    if [[ ! -f "$CONFIG_FILE" ]]; then
        cat > "$CONFIG_FILE" << 'EOF'
# Claude Code Session Manager Configuration
# Customize these settings for your workflow

# Popup dimensions
POPUP_WIDTH="60%"
POPUP_HEIGHT="60%"

# Color theme
COLOR_ACTIVE="#00ff41"      # Matrix green - actively working
COLOR_APPROVAL="#ffff00"    # Cyber yellow - needs approval
COLOR_IDLE="#8b93a6"        # Muted gray - idle/waiting for input
EOF
        echo "✅ Created configuration file: $CONFIG_FILE"
    fi

    # Make scripts executable
    chmod +x "$SCRIPT_DIR"/*.sh "$SCRIPT_DIR"/src/*.sh 2>/dev/null || true

    echo ""
    echo "🎉 Installation complete!"
    echo ""
    echo "Quick start:"
    echo "  $0 show                    # Show session status popup"
    echo "  $0 picker                  # Open fzf session picker"
    echo "  $0 jump approval           # Jump to sessions needing approval"
    echo ""
    echo "Add to tmux.conf for keybindings:"
    echo "  bind-key g run-shell 'claude-session-manager show'"
    echo "  bind-key G run-shell 'claude-session-manager picker'"
    echo ""
    echo "Configuration file: $CONFIG_FILE"
}

# Uninstall Claude Session Manager
uninstall_manager() {
    echo "🗑️  Uninstalling Claude Code Session Manager..."

    echo ""
    echo "Remove configuration directory? ($CONFIG_DIR)"
    read -p "y/N: " remove_config

    if [[ "$remove_config" =~ ^[Yy]$ ]]; then
        rm -rf "$CONFIG_DIR"
        echo "✅ Configuration removed"
    fi

    echo "✅ Uninstallation complete"
}

# Open configuration file
configure_manager() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "Configuration file not found. Run 'install' first."
        exit 1
    fi

    "${EDITOR:-nano}" "$CONFIG_FILE"
}

# Main command router
main() {
    case "${1:-help}" in
        # Display commands
        "show"|"popup")
            "$TMUX_SCRIPT" show
            ;;
        "picker")
            "$TMUX_SCRIPT" picker
            ;;

        # Session commands
        "list")
            "$DETECTOR_SCRIPT" list
            ;;
        "status")
            "$DETECTOR_SCRIPT" status "$2"
            ;;
        "switch")
            "$TMUX_SCRIPT" switch "$2"
            ;;

        # Quick navigation
        "jump")
            case "$2" in
                "approval")
                    "$TMUX_SCRIPT" jump-approval
                    ;;
                "active")
                    "$TMUX_SCRIPT" jump-active
                    ;;
                "idle")
                    "$TMUX_SCRIPT" jump-idle
                    ;;
                *)
                    echo "Usage: $0 jump {approval|active|idle}"
                    exit 1
                    ;;
            esac
            ;;

        # Status bar widget
        "widget")
            "$DETECTOR_SCRIPT" widget
            ;;

        # Hook integration (called from Claude Code hooks, stdin = JSON)
        "hook-status")
            "$DETECTOR_SCRIPT" write-status "$2"
            ;;

        # Setup commands
        "install")
            install_manager
            ;;
        "uninstall")
            uninstall_manager
            ;;
        "configure")
            configure_manager
            ;;

        # Info commands
        "version"|"--version"|"-v")
            show_version
            ;;
        "help"|"--help"|"-h"|*)
            show_help
            ;;
    esac
}

# Check dependencies
check_dependencies() {
    local missing_deps=()

    if ! command -v tmux >/dev/null 2>&1; then
        missing_deps+=("tmux")
    else
        local tmux_version
        tmux_version=$(tmux -V | sed 's/[^0-9.]//g')
        local tmux_major="${tmux_version%%.*}"
        if [[ "$tmux_major" -lt 3 ]] 2>/dev/null; then
            echo "⚠️  tmux 3.0+ required (found: $tmux_version)"
            exit 1
        fi
    fi

    if ! command -v bash >/dev/null 2>&1; then
        missing_deps+=("bash")
    else
        local bash_major="${BASH_VERSINFO[0]:-0}"
        if [[ "$bash_major" -lt 4 ]]; then
            echo "⚠️  bash 4.0+ required (found: $BASH_VERSION)"
            exit 1
        fi
    fi

    if ! command -v fzf >/dev/null 2>&1; then
        missing_deps+=("fzf")
    fi

    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        echo "❌ Missing dependencies: ${missing_deps[*]}"
        echo "Please install the missing dependencies and try again."
        exit 1
    fi

    if ! command -v pgrep >/dev/null 2>&1; then
        echo "⚠️  pgrep not found — process-based session detection will be limited"
    fi
}

# Check tmux is running
check_tmux_running() {
    if [[ -z "$TMUX" ]] && [[ "${1}" != "help" ]] && [[ "${1}" != "version" ]] && [[ "${1}" != "install" ]] && [[ "${1}" != "hook-status" ]]; then
        echo "❌ tmux not detected. Please run this command inside a tmux session."
        exit 1
    fi
}

# Run pre-checks
check_dependencies
check_tmux_running "$1"

# Execute main function
main "$@"
